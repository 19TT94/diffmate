{
  "name": "diffmate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "src/ui"
  ],
  "bin": {
    "diffmate": "bin/diffmate.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/engine/**/*.test.ts && npm run test:ui",
    "test:ui": "npm --prefix src/ui run test",
    "dev:ui": "npm --prefix src/ui run dev",
    "build:ui": "npm --prefix src/ui run build",
    "lint:ui": "npm --prefix src/ui run lint",
    "format": "prettier --check .",
    "demo": "tsx scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  }
}
